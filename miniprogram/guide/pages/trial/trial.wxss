.trial-page{padding-bottom:48rpx}.trial-intro,.trial-feedback{padding:24rpx;margin:24rpx 0;background:#fff9eb;border:1rpx solid #d8bd88;border-radius:18rpx}.trial-title{font-size:30rpx;font-weight:700;color:#263733}.trial-note{font-size:24rpx;line-height:1.75;color:#776d5d;margin:14rpx 0}.trial-status{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12rpx;font-size:24rpx;margin:18rpx 0}.red-side{color:#a9342a}.trial-actions{display:flex;gap:16rpx;margin:24rpx 0}.trial-actions button{flex:1;font-size:25rpx;color:#6d5031;background:#f8eedc;border:1rpx solid #d8bd88}.trial-error{padding:20rpx;border-radius:14rpx;background:#f9e7df;color:#a9342a;font-size:25rpx;line-height:1.7;margin:20rpx 0}.trial-link{background:transparent;color:#8e382b;font-size:26rpx;margin-top:20rpx}.trial-link::after{border:0}
