.tutorial-page{padding-bottom:56rpx}.steps{display:flex;gap:12rpx;margin:24rpx 0}.step{flex:1;padding:16rpx 4rpx;text-align:center;border:1rpx solid #d8cbb3;border-radius:14rpx;color:#82735d;font-size:24rpx}.step.active{background:#a9342a;color:#fff9ed;border-color:#a9342a}.step.done{background:#ece5d1;color:#5d663d}.lesson-card,.feedback,.completion-card{background:#fffaf0;border:1rpx solid #ddceb4;border-radius:20rpx;padding:24rpx}.lesson-eyebrow{font-size:21rpx;color:#8a7554;margin-bottom:10rpx}.lesson-title{font-size:34rpx;font-weight:700;color:#263128}.lesson-instruction{margin-top:14rpx;font-size:27rpx;line-height:1.7;color:#564c3e}.legend{display:flex;flex-wrap:wrap;gap:12rpx 22rpx;margin-top:18rpx;font-size:22rpx;color:#263128}.red-side{color:#a9342a}.feedback{margin:14rpx 0 24rpx}.feedback.success{border-color:#879467;background:#f4f5e7}.feedback-title{font-size:27rpx;font-weight:700;color:#354533}.feedback-text{margin-top:12rpx;font-size:25rpx;line-height:1.75;color:#615642}.retry-button{margin-top:18rpx;background:transparent;color:#8e382b;font-size:25rpx;border:1rpx solid #d9c6a9}.completion-card{margin-top:30rpx}.completion-seal{width:90rpx;height:90rpx;line-height:90rpx;margin:4rpx auto 28rpx;text-align:center;background:#a9342a;color:#fff9ed;border-radius:18rpx;font-size:48rpx}.completion-line{font-size:26rpx;line-height:1.8;margin-top:16rpx;color:#354533}.completion-note{font-size:24rpx;line-height:1.8;color:#766850;margin:24rpx 0}.tutorial-note{font-size:21rpx;line-height:1.7;color:#82735d;text-align:center;margin-top:28rpx}
.steps{flex-wrap:wrap}.step{flex:0 0 auto;box-sizing:border-box;width:calc(50% - 6rpx);font-size:22rpx;padding:14rpx 10rpx}.escape-routes{margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid #ddceb4}.escape-title{font-size:23rpx;color:#8e382b;margin-bottom:10rpx}.escape-route{display:inline-block;margin:0 16rpx 8rpx 0;font-size:23rpx;color:#615642}
