.feature{height:116rpx;margin-bottom:14rpx;border-radius:18rpx;display:flex;align-items:center;padding:0 28rpx;color:#fff9ef;border:1rpx solid rgba(255,238,203,.55);box-shadow:0 10rpx 24rpx rgba(10,18,18,.15);position:relative;overflow:hidden}.feature::before{content:'';position:absolute;right:-30rpx;top:-44rpx;width:180rpx;height:180rpx;border:1rpx solid rgba(255,255,255,.13);border-radius:50%}.feature.red{background:linear-gradient(105deg,#5d1e20,#a6362c 65%,#253b4d)}.feature.gold{background:linear-gradient(105deg,#5c462b,#9c7032,#5d4a34)}.feature.blue{background:linear-gradient(105deg,#173147,#2e6985,#15374c)}.feature.green{background:linear-gradient(105deg,#183e3b,#28705a,#1a4345)}.feature.purple{background:linear-gradient(105deg,#302647,#594076,#332d53)}.seal{width:64rpx;height:64rpx;border-radius:50%;background:rgba(255,245,218,.18);border:1rpx solid rgba(255,246,220,.55);display:flex;align-items:center;justify-content:center;font-family:serif;font-size:38rpx;margin-right:22rpx;flex:none}.copy{flex:1}.title{font-size:31rpx;font-weight:700;letter-spacing:2rpx}.subtitle{font-size:22rpx;opacity:.8;margin-top:3rpx}.arrow{font-size:48rpx;color:#ffe9bb}
