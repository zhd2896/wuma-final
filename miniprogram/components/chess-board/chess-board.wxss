.board-wrap{width:100%;padding:13rpx;background:linear-gradient(140deg,#67472d,#d1a266 7%,#7c5435 95%);border-radius:20rpx;box-shadow:0 16rpx 26rpx rgba(28,20,12,.28),inset 0 0 0 2rpx #e2bc7e}
.board-frame{width:100%;aspect-ratio:1/1;position:relative;overflow:hidden;border-radius:9rpx;background:#f2dfbc;border:2rpx solid #59391f;box-shadow:inset 0 0 24rpx rgba(96,53,20,.24)}
.board-landscape{position:absolute;inset:0;width:100%;height:100%;opacity:.09;pointer-events:none}
.grain{position:absolute;inset:0;background:repeating-linear-gradient(3deg,transparent 0,rgba(93,50,17,.035) 3rpx,transparent 6rpx);pointer-events:none}
.temple-label{position:absolute;z-index:2;font-family:serif;color:#2b2119;text-align:center;font-weight:700;line-height:1.1;pointer-events:none}
.temple-label text{display:block;font-size:15rpx;letter-spacing:1rpx;font-weight:400;margin-top:3rpx}
.temple-label.apex{left:36%;width:28%;top:1%;font-size:28rpx;letter-spacing:3rpx}
.temple-label.left-wing{left:16%;width:16%;top:18%;font-size:26rpx}
.temple-label.right-wing{right:16%;width:16%;top:18%;font-size:26rpx}
.corner{position:absolute;z-index:2;width:28rpx;height:28rpx;pointer-events:none;opacity:.63}
.top-left{top:9rpx;left:9rpx;border-top:4rpx double #5f442b;border-left:4rpx double #5f442b}
.top-right{top:9rpx;right:9rpx;border-top:4rpx double #5f442b;border-right:4rpx double #5f442b}
.bottom-left{bottom:9rpx;left:9rpx;border-bottom:4rpx double #5f442b;border-left:4rpx double #5f442b}
.bottom-right{bottom:9rpx;right:9rpx;border-bottom:4rpx double #5f442b;border-right:4rpx double #5f442b}
.line{position:absolute;height:3rpx;background:#32271c;transform-origin:0 50%;pointer-events:none}
.recommend-line{position:absolute;height:7rpx;background:#2c9cd5;border-radius:10rpx;transform-origin:0 50%;z-index:3;box-shadow:0 0 12rpx #57c7ff;pointer-events:none}
.arrow-head{position:absolute;right:-4rpx;top:-7rpx;width:0;height:0;border-top:10rpx solid transparent;border-bottom:10rpx solid transparent;border-left:17rpx solid #2c9cd5}
.node-hit,.piece-position{position:absolute;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center}
.node-hit{z-index:4}
.node-hit.last-target,.node-hit.capture-spot{z-index:6}
.node-hit.last-target::after{content:'';position:absolute;left:50%;top:50%;width:65rpx;height:65rpx;border:3rpx solid #2c9cd5;border-radius:50%;transform:translate(-50%,-50%);pointer-events:none}
.node-dot{width:11rpx;height:11rpx;border-radius:50%;background:#211b17}
.node-dot.target{box-shadow:0 0 0 5rpx #e9f9ff,0 0 0 13rpx rgba(32,151,216,.43)}
.node-dot.source{box-shadow:0 0 0 6rpx rgba(255,203,104,.77)}
.node-dot.legal-target{width:25rpx;height:25rpx;background:rgba(52,151,104,.28);border:3rpx solid #267a55;box-shadow:0 0 0 6rpx rgba(52,151,104,.16)}
.node-dot.capture-hit,.node-dot.replacement-hit{position:relative}
.node-dot.capture-hit::after{content:'';position:absolute;left:50%;top:50%;width:72rpx;height:72rpx;border:4rpx solid #cc5142;border-radius:50%;transform:translate(-50%,-50%);animation:capture-pulse 1.1s ease-out 2;pointer-events:none}
.node-dot.replacement-hit::before{content:'';position:absolute;left:50%;top:50%;width:61rpx;height:61rpx;border:3rpx solid #23876c;border-radius:50%;transform:translate(-50%,-50%);pointer-events:none}
@keyframes capture-pulse{0%{opacity:1;transform:translate(-50%,-50%) scale(.4)}100%{opacity:0;transform:translate(-50%,-50%) scale(1.7)}}
.piece-position{z-index:5;width:55rpx;height:55rpx;pointer-events:none}
.board-plaque{position:absolute;left:37%;right:37%;bottom:2%;height:30rpx;display:flex;align-items:center;justify-content:center;background:linear-gradient(120deg,#4d3525,#785337,#4d3525);border:2rpx solid #ab854e;color:#f0d6a2;font-family:serif;font-size:20rpx;letter-spacing:3rpx;border-radius:4rpx;pointer-events:none}
.board-caption{display:flex;justify-content:space-between;padding:9rpx 8rpx 0;color:#f4dcb9;font-size:18rpx;letter-spacing:2rpx}
.compact .board-caption{display:none}.compact{padding:8rpx;border-radius:12rpx}
.compact .piece-position{transform:translate(-50%,-50%) scale(.7)}
.compact .temple-label.apex{font-size:21rpx}.compact .temple-label.left-wing,.compact .temple-label.right-wing{font-size:19rpx}
.compact .temple-label text{font-size:11rpx}
.compact .board-plaque{height:23rpx;font-size:14rpx}
.node-label{position:absolute;z-index:8;transform:translate(24rpx,18rpx);padding:2rpx 5rpx;border-radius:5rpx;background:rgba(255,249,237,.95);color:#352a20;font-size:22rpx;line-height:26rpx;font-weight:600;white-space:nowrap;pointer-events:none;box-shadow:0 1rpx 3rpx rgba(30,20,15,.12)}
.node-label.label-source{background:#f3d7a1;color:#4b3312;box-shadow:0 0 0 2rpx #bd8c42}
.node-label.label-target{background:#d8f0ff;color:#145c81;box-shadow:0 0 0 2rpx #2c9cd5}
.node-label.label-focus{background:#d8f0ff;color:#145c81;box-shadow:0 0 0 2rpx #2c9cd5}
.compact .node-label{transform:translate(20rpx,15rpx);font-size:22rpx}
.node-dot.source{background:#a27021}

.guidance-marker{position:absolute;z-index:7;transform:translate(-50%,-42rpx);padding:2rpx 6rpx;border-radius:5rpx;font-size:22rpx;line-height:26rpx;font-weight:600;pointer-events:none;white-space:nowrap}.legal-marker{background:#e0f3e6;color:#1f6544;border:1rpx solid #267a55}.capture-marker{background:#fff0df;color:#8b3c20;border:1rpx solid #b77940}
.plain-piece{width:53rpx;height:53rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;border:3rpx solid #fff;font-size:28rpx;font-weight:700;color:#fff;box-shadow:0 0 0 2rpx #111}.plain-piece.black{background:#111}.plain-piece.red{background:#a31d16}.plain-piece.selected{box-shadow:0 0 0 6rpx #006a9c}.plain-piece.lastMove{box-shadow:0 0 0 5rpx #926300}.plain-piece.captured{opacity:.35}
.high-contrast{background:#222;box-shadow:none}.high-contrast .board-frame{background:#fff8e8;border-color:#111;box-shadow:none}.high-contrast .board-landscape,.high-contrast .grain,.high-contrast .corner{display:none}.high-contrast .line{background:#151515;height:4rpx}.high-contrast .recommend-line{background:#006998;box-shadow:none}.high-contrast .arrow-head{border-left-color:#006998}.high-contrast .node-label{background:#fff;color:#111;box-shadow:0 0 0 2rpx #444}.high-contrast .label-source{background:#fff0b0}.high-contrast .label-target{background:#c7edff}.high-contrast .legal-marker{background:#e1ffe9;color:#104b2b;border:2rpx solid #104b2b}
.large-text .node-label,.large-text.compact .node-label{font-size:28rpx;line-height:32rpx}.large-text .guidance-marker{font-size:28rpx;line-height:32rpx}.large-text .temple-label text{font-size:20rpx}.large-text .board-caption{font-size:24rpx}
.node-label.label-at-right,.compact .node-label.label-at-right{transform:translate(-100%,18rpx);margin-left:-20rpx}.endpoint-label{display:block;text-align:center}
