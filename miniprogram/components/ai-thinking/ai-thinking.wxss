.thinking{display:flex;align-items:center;gap:18rpx;padding:24rpx;background:linear-gradient(115deg,#173149,#1a2533);border:1rpx solid #3d789e;border-radius:20rpx;color:#eefaff}.orb{height:54rpx;width:54rpx;border-radius:50%;background:radial-gradient(circle,#78d4ff,#1672b1 65%,#0d345c);box-shadow:0 0 20rpx #278dcc;display:flex;align-items:center;justify-content:center;animation:breathe 2s ease-in-out infinite}.eye{width:25rpx;height:12rpx;background:#132d52;border-radius:10rpx;box-shadow:0 0 8rpx #b9eeff inset}.title{font-size:24rpx}.sub{font-size:19rpx;color:#a3bfce;margin-top:4rpx}.dots{margin-left:auto;color:#7bc8ed;font-size:34rpx}@keyframes breathe{50%{opacity:.68;transform:scale(.94)}}
