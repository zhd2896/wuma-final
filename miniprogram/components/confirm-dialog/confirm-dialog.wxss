.mask{position:fixed;inset:0;background:rgba(10,18,20,.58);z-index:100;display:flex;align-items:center;justify-content:center}.dialog{width:610rpx;max-width:90vw;background:#fff9ef;border-radius:23rpx;border:2rpx solid #d9bb81;padding:35rpx;box-shadow:0 20rpx 70rpx rgba(0,0,0,.24);animation:appear .2s ease}.title{font-size:30rpx;font-weight:700;color:#243234}.body{font-size:24rpx;color:#6d706b;margin:17rpx 0 28rpx;line-height:1.6}.actions{display:flex;gap:18rpx}.actions button{flex:1;background:#eee6d8;color:#39423f;font-size:24rpx}.actions .confirm{background:#a83a30;color:#fff8ed}.actions button::after{border:0}@keyframes appear{from{opacity:0;transform:translateY(15rpx)}to{opacity:1;transform:translateY(0)}}
