.nav{position:fixed;left:0;right:0;bottom:0;z-index:50;display:flex;background:#fff8eb;border-top:1rpx solid #dbccb4;padding:12rpx 10rpx calc(10rpx + env(safe-area-inset-bottom));box-shadow:0 -8rpx 22rpx rgba(20,30,28,.08)}.nav-item{flex:1;display:flex;align-items:center;flex-direction:column;gap:2rpx;color:#6b716d;font-size:20rpx}.nav-item.active{color:#a9342a;font-weight:700}.nav-icon{font-size:38rpx;line-height:44rpx}
