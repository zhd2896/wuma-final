.card{display:flex;align-items:center;background:#fff8ec;border:1rpx solid #e6d4b9;border-radius:17rpx;padding:16rpx;margin-bottom:13rpx;gap:17rpx}.mini-board{width:90rpx;height:90rpx;background:linear-gradient(135deg,#e9c696,#f5dfb9);border:1rpx solid #c79859;border-radius:8rpx;display:flex;align-items:center;justify-content:center;flex:none}.mini-lines{font-size:23rpx;line-height:22rpx;color:#664527;text-align:center}.copy{flex:1;min-width:0}.title{font-size:25rpx;font-weight:700}.sub{font-size:20rpx;color:#847969;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.stars{font-size:21rpx;color:#ba7d2e;margin-top:5rpx}.status{background:linear-gradient(135deg,#f3d398,#cc944c);border-radius:10rpx;padding:10rpx 14rpx;font-size:21rpx;color:#483019}
