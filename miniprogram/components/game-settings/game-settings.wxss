.game-settings{overflow:hidden;border:1rpx solid #dfcfb7;border-radius:18rpx;background:#fffaf1}.setting-row{display:flex;align-items:center;gap:24rpx;padding:24rpx;border-bottom:1rpx solid #eee1ce}.setting-row:last-child{border-bottom:0}.setting-copy{flex:1;min-width:0}.setting-title{font-size:26rpx;font-weight:700;color:#293635}.setting-description{margin-top:7rpx;font-size:20rpx;line-height:1.45;color:#7a7f79}.setting-row-column{display:block}.first-player-options{display:flex;gap:36rpx;margin-top:20rpx}.player-option{display:flex;align-items:center;gap:8rpx;font-size:23rpx;color:#414a47}
