.panel{padding:26rpx;border-radius:20rpx;background:linear-gradient(135deg,#fff7e9,#f7e4c9);border:1rpx solid #dfc196}.head{display:flex;justify-content:space-between;font-size:24rpx;font-weight:700}.demo{font-size:20rpx;color:#2a7597;font-weight:400}.score{font-size:64rpx;color:#a7352d;font-family:Georgia,serif;font-weight:700;line-height:1.2;margin-top:9rpx}.adv{font-size:24rpx;color:#715c44}.track{height:13rpx;border-radius:10rpx;background:linear-gradient(90deg,#ae4032 0 54%,#b3b9a8 54%);margin:22rpx 0;position:relative}.marker{position:absolute;left:52%;top:-6rpx;width:7rpx;height:25rpx;background:#fff;box-shadow:0 0 4rpx #333}.trend{font-size:22rpx;color:#746b5d}
