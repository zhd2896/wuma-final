.panel{padding:26rpx;border-radius:20rpx;background:#fff8ec;border:1rpx solid #dfc196;color:#3d3429}.head{display:flex;justify-content:space-between;gap:16rpx;font-size:23rpx;color:#756650}.verdict{font-size:34rpx;font-weight:700;line-height:1.4;margin:18rpx 0}.advantage{color:#39754b}.disadvantage{color:#a7352d}.balanced,.finished{color:#3f5652}.reasons{font-size:25rpx;line-height:1.7}.reason{margin:8rpx 0}.quality{font-size:22rpx;color:#746b5d;line-height:1.6;margin:16rpx 0}.section-label{font-size:24rpx;font-weight:700;margin:22rpx 0 12rpx}.move-button{display:block;width:100%;box-sizing:border-box;margin:12rpx 0;padding:18rpx;text-align:left;border:1rpx solid #e0d1b9;border-radius:12rpx;background:#fffdf8;color:#3d3429;font-size:25rpx;line-height:1.6;white-space:normal}.move-button::after{border:0}.move-button text{display:inline-block;font-size:21rpx;color:#53615b;margin-left:12rpx}.primary{border-color:#6b926f;background:#f2f6e9}.move-detail,.move-action{font-size:22rpx;color:#655f53;line-height:1.6;margin-top:6rpx}.move-action{color:#39754b}.metric-row{display:flex;justify-content:space-between;gap:18rpx;font-size:23rpx;line-height:1.6;border-bottom:1rpx solid #eadfce;padding:12rpx 0}.metric-row>text:last-child{font-weight:600;white-space:nowrap}.detail-note,.search-meta{font-size:22rpx;line-height:1.7;color:#746b5d;margin:8rpx 0}.search-meta{margin-top:18rpx}
.move-purpose{margin-top:10rpx;font-size:24rpx;line-height:1.7;color:#3f5652;font-weight:500}.outlook{margin:16rpx 0;padding:14rpx 16rpx;border-left:4rpx solid #b59664;background:#f8efd9;font-size:23rpx;line-height:1.7;color:#65543c}
