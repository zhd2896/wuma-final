.player{display:flex;align-items:center;gap:10rpx;min-width:0}.avatar{width:64rpx;height:64rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:33rpx;border:2rpx solid #d4b578;background:linear-gradient(135deg,#f9dfad,#ad7540);color:#3f2d21;flex:none}.avatar.ai{background:linear-gradient(135deg,#183f60,#126f9b);color:#e8faff;border-color:#58bce5;box-shadow:0 0 14rpx rgba(38,158,224,.3)}.meta{min-width:0}.name{font-size:23rpx;font-weight:700;white-space:nowrap}.sub,.pieces{font-size:19rpx;color:#ead8bb;white-space:nowrap}
