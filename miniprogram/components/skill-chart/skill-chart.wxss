.skill-chart{width:100%;color:#39493f}.chart-caption{font-size:23rpx;line-height:1.6;color:#766850;text-align:center;margin:12rpx 0 20rpx}.chart-square{position:relative;width:100%;aspect-ratio:1/1}.chart-line{position:absolute;height:1rpx;transform-origin:0 50%;pointer-events:none}.grid-line{background:#e0d5c3}.axis-line{background:#c6b89e}.data-line{height:4rpx;background:#ae4637;z-index:2}.chart-point{position:absolute;width:12rpx;height:12rpx;background:#a9342a;border:2rpx solid #fff8ed;border-radius:50%;transform:translate(-50%,-50%);z-index:3}.chart-scale{position:absolute;font-size:18rpx;color:#91816b;transform:translateY(-50%);z-index:1}.chart-label{position:absolute;width:26%;font-size:22rpx;text-align:center;line-height:1.5;transform:translate(-50%,-50%);z-index:4}.chart-label text{display:block}.chart-value{font-size:20rpx;color:#a54a38}.line .chart-label{width:14%;font-size:21rpx;line-height:1.4}.line .chart-value{font-size:19rpx;margin-top:4rpx}.line .chart-scale{transform:translate(-50%,-50%)}.chart-notice{font-size:22rpx;line-height:1.7;color:#79684b;background:#f8efdf;border-radius:12rpx;padding:16rpx;margin-top:18rpx}.bar-scale{display:flex;justify-content:space-between;font-size:20rpx;color:#91816b;margin-bottom:20rpx}.bar-row{margin:22rpx 0}.bar-heading{display:flex;justify-content:space-between;font-size:25rpx;gap:16rpx;margin-bottom:12rpx}.bar-value{font-size:23rpx;color:#a54a38}.bar-track{height:18rpx;background:#e8dcc9;border-radius:10rpx;overflow:hidden}.bar-fill{height:100%;background:linear-gradient(90deg,#bd8d4d,#b33d32);border-radius:10rpx}
