.piece{height:53rpx;width:53rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;position:relative;box-shadow:0 5rpx 8rpx rgba(30,20,15,.36),inset 0 2rpx 2rpx rgba(255,255,255,.42);border:3rpx solid rgba(34,20,17,.75);font-family:serif;font-size:24rpx;font-weight:700;transition:transform .2s ease}.piece.red{background:radial-gradient(circle at 32% 24%,#d75d48,#a52d29 72%,#5e191a);color:#fff3d8}.piece.black{background:radial-gradient(circle at 32% 24%,#62615a,#282c2a 72%,#111b1c);color:#f4ddac}.piece.selected{transform:scale(1.18);box-shadow:0 0 0 6rpx rgba(51,137,194,.28),0 4rpx 10rpx rgba(22,30,30,.4)}.piece.legalTarget{box-shadow:0 0 0 7rpx rgba(53,165,108,.35),0 5rpx 8rpx rgba(30,20,15,.36)}.piece.lastMove{box-shadow:0 0 0 5rpx rgba(243,207,119,.48),0 5rpx 8rpx rgba(30,20,15,.36)}.piece.recommended{box-shadow:0 0 0 6rpx rgba(45,152,218,.38),0 5rpx 12rpx rgba(30,20,15,.4)}.piece.captured{opacity:.35;transform:scale(.78)}.glint{position:absolute;left:10rpx;top:6rpx;width:13rpx;height:5rpx;background:rgba(255,255,255,.46);border-radius:50%}
