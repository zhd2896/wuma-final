.item{display:flex;align-items:center;gap:16rpx;padding:18rpx 0;border-bottom:1rpx solid #e9dcc9}.turn{font-size:21rpx;color:#8e7e6b;background:#f2e8d8;padding:8rpx;border-radius:8rpx}.body{flex:1;min-width:0}.notation{font-size:24rpx;font-weight:700}.detail{font-size:19rpx;color:#7e7e76;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.right{text-align:right}.badge{display:inline-block;border-radius:7rpx;background:#377f67;color:#fff;font-size:19rpx;padding:3rpx 9rpx}.badge.normal{background:#b48a44}.badge.bad{background:#cd743d}.badge.severe{background:#b63e34}.score{font-size:19rpx;color:#91642d;margin-top:3rpx}
