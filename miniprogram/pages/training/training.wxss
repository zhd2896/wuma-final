.training-page{background:#f4eee2}.training-banner{margin-top:24rpx;height:190rpx;padding:25rpx 29rpx;position:relative;overflow:hidden}.banner-kicker{font-size:19rpx;color:#e3c991;letter-spacing:4rpx}.banner-title{font-size:39rpx;font-family:serif;letter-spacing:6rpx;margin:9rpx 0}.banner-copy{font-size:20rpx;color:#cbcfca;position:relative;z-index:1}.banner-art{position:absolute;right:32rpx;top:-52rpx;font-size:260rpx;color:rgba(224,179,110,.2);font-family:serif}.training-status{padding:24rpx;margin:20rpx 0;font-size:24rpx;color:#635e51}.training-status button{margin-top:14rpx}.training-item{padding:24rpx;margin:14rpx 0;font-size:28rpx}.training-item text{display:block;color:#81796b;font-size:21rpx;margin-top:8rpx}.category{float:right;color:#9b652d;font-size:20rpx}.challenge-heading{padding:22rpx;margin:23rpx 0;font-size:29rpx;font-weight:700}.challenge-heading text{display:block;font-size:21rpx;color:#808273;font-weight:400;margin-top:6rpx}.training-reserve{padding:12rpx 22rpx;margin:-10rpx 0 18rpx;font-size:21rpx;color:#635e51}.challenge-board{max-width:700rpx;margin:auto}.training-result{margin-top:22rpx;padding:22rpx;font-size:23rpx;line-height:1.8}.training-result-title{font-size:30rpx;font-weight:700;color:#755025}.training-actions{display:flex;gap:12rpx;margin-top:18rpx}.training-actions button{flex:1}.exit-btn{margin-top:18rpx}
