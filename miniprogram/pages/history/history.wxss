.history-page{background:#f3ede2}.history-head{margin:25rpx 0 10rpx;padding:26rpx;border-radius:20rpx;background:linear-gradient(120deg,#24363c,#5b5e50);color:#f8ebd3;font-family:serif;font-size:30rpx}.history-head text{display:block;font-family:sans-serif;font-size:20rpx;color:#c8cbbd;margin-top:7rpx}.history-toggle{text-align:right;color:#a67541;font-size:20rpx;margin:15rpx 0}.record{display:flex;align-items:center;padding:21rpx;margin-bottom:14rpx;gap:19rpx}.record-icon{width:70rpx;height:70rpx;flex:none;border:2rpx solid #b0764b;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:serif;font-size:30rpx;color:#a93e34;background:#f8e7c9}.record-main{flex:1;min-width:0}.record-name{font-size:25rpx;font-weight:700}.record-name text{font-size:19rpx;color:#b04a36;margin-left:12rpx;font-weight:400}.record-meta,.record-review{font-size:19rpx;color:#808178;margin-top:4rpx}.record-review{color:#408198}.chevron{font-size:41rpx;color:#c29b65}
