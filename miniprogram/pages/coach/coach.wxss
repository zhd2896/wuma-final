.coach-page{background:#f5efe4}.coach-hero{height:325rpx;background:#efe5d5;position:relative;overflow:hidden}.coach-art{position:absolute;inset:0;width:100%;height:100%}.coach-hero::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,249,238,.48),transparent 80%)}.hero-copy{position:absolute;z-index:1;left:35rpx;top:58rpx;color:#253733}.hero-kicker{font-size:22rpx;letter-spacing:5rpx;color:#9e6b36}.hero-title{font-family:serif;font-size:48rpx;font-weight:700;line-height:1.35;margin-top:16rpx}.speech{position:relative;margin-top:-27rpx;padding:29rpx 30rpx 23rpx;font-size:25rpx;line-height:1.7;color:#394946}.quote-mark{position:absolute;top:2rpx;right:22rpx;font-family:serif;font-size:75rpx;color:#d8ba8b;line-height:1}.speech-source{text-align:right;font-size:20rpx;color:#a37b48;margin-top:9rpx}.coach-intro{color:#777b73;font-size:22rpx;margin:-4rpx 0 20rpx}.review-entry{display:flex;justify-content:space-between;align-items:center;padding:22rpx 25rpx;margin-top:23rpx;font-weight:700;font-size:26rpx}.review-entry text{display:block;color:#c8d4d0;font-size:20rpx;font-weight:400;margin-top:5rpx}.review-entry>view:last-child{font-size:46rpx;color:#e1bf82}
