.coach-page{background:#f5efe4;padding-bottom:130rpx}.coach-hero{height:280rpx;background:#efe5d5;position:relative;overflow:hidden}.coach-art{position:absolute;inset:0;width:100%;height:100%}.coach-hero::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,249,238,.55),transparent 82%)}.hero-copy{position:absolute;z-index:1;left:35rpx;top:48rpx;color:#253733}.hero-kicker{font-size:22rpx;letter-spacing:5rpx;color:#9e6b36}.hero-title{font-family:serif;font-size:44rpx;font-weight:700;line-height:1.35;margin-top:14rpx}.state-card{margin-top:24rpx;padding:28rpx}.state-title{font-size:28rpx;font-weight:700;color:#253733}.state-detail{font-size:22rpx;line-height:1.7;color:#6d756f;margin-top:10rpx}.state-actions{display:flex;gap:16rpx;margin-top:20rpx}.state-actions button{flex:1}.game-meta{margin-top:-22rpx;position:relative;z-index:2;padding:20rpx 24rpx;display:grid;grid-template-columns:1fr 1fr;gap:14rpx 22rpx}.game-meta>view{display:flex;justify-content:space-between;gap:12rpx;font-size:21rpx;color:#5e6863}.game-meta text:last-child{color:#253733;font-weight:700;max-width:240rpx;overflow:hidden;text-overflow:ellipsis}.board-preview{margin:20rpx auto;width:560rpx;max-width:100%}.notice-card{padding:20rpx 24rpx;margin:14rpx 0;color:#6c4c28;font-size:23rpx;line-height:1.6}.coach-intro{color:#777b73;font-size:22rpx;margin:-4rpx 0 20rpx}.inline-error{background:#fff1ee;color:#a13d32;padding:16rpx 20rpx;border-radius:12rpx;margin-bottom:16rpx;font-size:22rpx}.continue-button{margin:22rpx 0}.review-entry{display:flex;justify-content:space-between;align-items:center;padding:22rpx 25rpx;margin-top:23rpx;font-weight:700;font-size:26rpx}.review-entry text{display:block;color:#c8d4d0;font-size:20rpx;font-weight:400;margin-top:5rpx}.review-entry>view:last-child{font-size:46rpx;color:#e1bf82}
