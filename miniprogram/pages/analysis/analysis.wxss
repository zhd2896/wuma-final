.analysis-page{background:#f4efe5}.board-preview{max-width:540rpx;margin:16rpx auto}.note-card,.metric-card{padding:12rpx 22rpx}.note-row,.metric-row{padding:17rpx 0;border-bottom:1rpx solid #eadfce;font-size:24rpx;display:flex;align-items:flex-start;gap:12rpx}.note-row:last-child,.metric-row:last-child{border-bottom:0}.note-row>text{color:#ae7046}.note-detail{font-size:20rpx;color:#7a817b;margin-top:6rpx}.metric-row{justify-content:space-between}.metric-row text:last-child{font-weight:700;color:#9c362e}.recommend{padding:24rpx}.recommend-top{display:flex;justify-content:space-between;font-size:32rpx;font-weight:700;color:#9c362e}.recommend-top text{font-size:20rpx;color:#267995;background:#e6f3f5;border-radius:20rpx;padding:8rpx 14rpx;font-weight:400}.recommend-body{font-size:23rpx;color:#53615b;line-height:1.6;margin-top:15rpx}.disclaimer,.search-meta{text-align:center;color:#7e817b;font-size:19rpx;line-height:1.6;margin:25rpx 0}.empty-card{padding:34rpx 26rpx;text-align:center;margin-top:24rpx}.empty-title{font-size:28rpx;font-weight:700}.empty-detail{font-size:22rpx;color:#777f79;margin:14rpx 0 24rpx}.empty-actions{display:flex;gap:14rpx}.empty-actions button{flex:1;font-size:22rpx}.empty-inline{padding:24rpx;text-align:center;color:#777f79;font-size:22rpx}
