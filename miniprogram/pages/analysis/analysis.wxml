<view class="page analysis-page"><view class="topbar"><text class="topbar-back" bindtap="back">‹</text>局面分析<text class="topbar-tag">演示数据</text></view>
  <view class="page-inner"><view class="tabs"><view class="tab {{tab == 'evaluation' ? 'active' : ''}}" data-tab="evaluation" bindtap="setTab">局面评估</view><view class="tab {{tab == 'pieces' ? 'active' : ''}}" data-tab="pieces" bindtap="setTab">关键棋子</view><view class="tab {{tab == 'moves' ? 'active' : ''}}" data-tab="moves" bindtap="setTab">推荐行动</view></view>
  <loading-state wx:if="{{state == 'loading'}}" message="正在分析局面..." /><error-state wx:elif="{{state == 'error'}}" message="演示分析暂不可用" bind:retry="retry" />
  <block wx:else><view wx:if="{{tab == 'evaluation'}}"><evaluation-panel score="{{analysis.score}}" advantage="{{analysis.advantage}}" trend="{{analysis.trend}}" /><section-title title="当前局面" subtitle="演示棋盘" /><view class="board-preview"><chess-board board="{{board}}" compact="{{true}}" /></view><section-title title="关键威胁" /><view class="note-card card"><view wx:for="{{analysis.threats}}" wx:key="*this" class="note-row"><text>◇</text>{{item}}</view></view></view>
  <view wx:elif="{{tab == 'pieces'}}"><section-title title="关键棋子" subtitle="演示标注" /><view class="note-card card"><view wx:for="{{analysis.keyPieces}}" wx:key="*this" class="note-row"><text>✦</text>{{item}}</view></view><view class="board-preview"><chess-board board="{{board}}" compact="{{true}}" /></view></view>
  <view wx:else><section-title title="最佳行动推荐" subtitle="演示数据" /><view class="recommend card"><view class="recommend-top">{{analysis.recommendation.notation}}<text>推荐行动</text></view><view class="recommend-body">{{analysis.recommendation.detail}}</view></view><view class="board-preview"><chess-board board="{{board}}" compact="{{true}}" /></view><section-title title="候选行动" /><candidate-move-list moves="{{analysis.candidates}}" /></view>
  <view class="disclaimer">局面评分仅用于 UI 演示，不代表胜率或真实 AI 输出。</view></block></view>
</view>
