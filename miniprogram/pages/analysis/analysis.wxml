<view class="page analysis-page">
  <view class="topbar"><text class="topbar-back" bindtap="back">‹</text>局面分析<text class="topbar-tag">真实局面</text></view>
  <view class="page-inner">
    <view class="tabs"><view class="tab {{tab == 'evaluation' ? 'active' : ''}}" data-tab="evaluation" bindtap="setTab">局面评估</view><view class="tab {{tab == 'pieces' ? 'active' : ''}}" data-tab="pieces" bindtap="setTab">关键棋子</view><view class="tab {{tab == 'moves' ? 'active' : ''}}" data-tab="moves" bindtap="setTab">推荐行动</view></view>
    <loading-state wx:if="{{state == 'loading'}}" message="正在分析真实局面..." />
    <error-state wx:elif="{{state == 'error' || state == 'conflict'}}" message="{{errorMessage}}" bind:retry="retry" />
    <view wx:elif="{{state == 'empty'}}" class="empty-card card">
      <view class="empty-title">当前没有可分析的棋局</view>
      <view class="empty-detail">开始一局本地对弈，或从历史记录选择棋局。</view>
      <view class="empty-actions"><button bindtap="startLocalGame">开始本地对局</button><button bindtap="openHistory">查看历史对局</button></view>
    </view>
    <block wx:elif="{{state == 'success' && view}}">
      <view wx:if="{{seat}}" class="note-card card">你执{{seat == 'A' ? '黑方' : '红方'}} · 分析视角：{{view.perspectiveLabel}}</view>
      <view id="analysis-board-preview" class="analysis-board-area">
        <view wx:if="{{previewMoveId}}" class="preview-notice">
          <view class="preview-heading"><text>{{previewText}}</text><button size="mini" bindtap="clearPreview">清除预览</button></view>
          <view class="preview-purpose">{{previewPurpose}}</view>
          <view class="preview-note">路线仅供查看，棋子尚未移动。</view>
        </view>
        <view class="board-preview"><chess-board board="{{previewBoard}}" compact="{{true}}" show-node-labels="{{true}}" /></view>
        <view class="note-card card">{{view.sideLabels.A}}备用棋 {{view.reserve.A}} · {{view.sideLabels.B}}备用棋 {{view.reserve.B}}</view>
        <view wx:if="{{routeText}}" class="search-meta">{{routeText}}</view>
      </view>
      <view wx:if="{{tab == 'evaluation'}}">
        <evaluation-panel analysis="{{view}}" reset-key="{{gameId + ':' + gameVersion}}" bind:select="selectMove" />
      </view>
      <view wx:elif="{{tab == 'pieces'}}">
        <section-title title="关键棋子" subtitle="由威胁和候选走法提取" />
        <view class="note-card card" wx:if="{{view.keyPieces.length}}"><view wx:for="{{view.keyPieces}}" wx:key="nodeId" class="note-row"><text>✦</text><view><view>{{item.nodeId}} · {{item.sideLabel}}</view><view class="note-detail">{{item.reason}}</view></view></view></view>
        <view wx:else class="empty-inline card">当前没有可标记的关键棋子</view>
      </view>
      <view wx:else>
        <section-title title="推荐尝试" subtitle="点击走法，在棋盘上查看路线" />
        <view wx:if="{{view.bestMove}}" class="recommend card" bindtap="showBestMove"><view class="recommend-top">{{view.bestMove.notation}}<text>{{view.perspectiveLabel}}的走法</text></view><view class="recommend-body">{{view.bestMove.purpose}}</view><view class="recommend-body">{{view.bestMove.detail}}</view></view>
        <view wx:elif="{{view.terminal}}" class="empty-inline card">
          <view>当前为终局，无可推荐走法</view>
          <view wx:if="{{view.winner}}">{{view.presentation.title}}</view>
          <view>{{view.presentation.reasons[0]}}</view>
        </view>
        <view wx:else class="empty-inline card">当前没有合法推荐走法</view>
        <section-title title="备选走法" subtitle="可点击备选走法查看路线" />
        <candidate-move-list wx:if="{{view.alternatives.length}}" moves="{{view.alternatives}}" bind:select="selectMove" />
        <view wx:else class="empty-inline card">没有其他候选走法</view>
      </view>
      <view class="disclaimer">{{view.presentation.quality}}</view>
    </block>
  </view>
</view>
