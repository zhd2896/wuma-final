.review-page{background:#f3ede1;min-height:100vh}.review-status{margin-top:22rpx;padding:26rpx;font-size:25rpx;color:#52615c}.review-status button{margin-top:16rpx}.match-summary{margin-top:22rpx;padding:26rpx;background:linear-gradient(110deg,#fff8e8,#e8d2ad)}.match-title{font-size:31rpx;font-weight:700}.match-meta{display:flex;gap:12rpx;margin-top:16rpx;flex-wrap:wrap}.match-meta text{font-size:20rpx;background:rgba(255,255,255,.65);color:#6c5942;border-radius:13rpx;padding:5rpx 12rpx}.review-stats{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin:15rpx 0;padding:22rpx;font-size:23rpx;color:#374842}.review-metric{margin:12rpx 0;padding:18rpx 22rpx;font-size:23rpx}.review-move{margin:13rpx 0;padding:21rpx;font-size:23rpx;line-height:1.7}.review-move-head{font-size:26rpx;font-weight:700;display:flex;justify-content:space-between}.category{color:#a54534}.review-explanation{color:#465b56;margin-top:8rpx}.review-detail{color:#8c8172;font-size:20rpx;margin-top:8rpx}.disclaimer{text-align:center;color:#928877;font-size:20rpx;margin:25rpx auto;line-height:1.5}
.review-natural{margin:12rpx 0;padding:20rpx 22rpx;font-size:23rpx;line-height:1.7;color:#374842}.review-natural-title{font-size:27rpx;font-weight:700}.review-natural-move{margin-top:10rpx;padding:12rpx;background:#fff8e8;color:#435a52;border-radius:8rpx}
