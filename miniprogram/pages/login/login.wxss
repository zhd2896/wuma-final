.login-page{min-height:100vh;background:#f4eee2;position:relative;overflow:hidden;color:#283a32}.login-landscape{position:absolute;inset:0;width:100%;height:100%;opacity:.13}.login-content{position:relative;padding:150rpx 48rpx 60rpx;text-align:center}.login-seal{margin:0 auto 30rpx;width:100rpx;height:100rpx;line-height:100rpx;border:3rpx solid #a94336;color:#a94336;font-family:serif;font-size:62rpx;border-radius:8rpx;transform:rotate(-5deg)}.login-title{font-size:56rpx;font-family:serif;letter-spacing:10rpx;font-weight:700}.login-subtitle{margin-top:20rpx;font-size:24rpx;color:#748075;letter-spacing:4rpx}.login-card{margin-top:90rpx;background:rgba(255,252,245,.93);border:1rpx solid #dfd3bf;border-radius:24rpx;padding:46rpx 32rpx;box-shadow:0 15rpx 50rpx rgba(47,53,37,.06)}.login-heading{font-size:34rpx;font-weight:700}.login-description{font-size:25rpx;line-height:1.8;color:#6a756b;margin:20rpx 0 36rpx}.wechat-login{background:#28764a;color:white;border-radius:14rpx;font-size:29rpx;line-height:94rpx}.wechat-login[disabled]{background:#70947e;color:#fff}.wechat-login::after{border:0}.login-note{font-size:21rpx;line-height:1.8;color:#879085;margin-top:28rpx}.login-error{font-size:24rpx;line-height:1.7;color:#a94336;margin-top:24rpx}.login-footer{font-size:23rpx;letter-spacing:5rpx;color:#8b8d7c;margin-top:72rpx}
.rules-link{margin-top:24rpx;background:transparent;color:#71572d;font-size:26rpx;line-height:2}.rules-link::after{border:0}
