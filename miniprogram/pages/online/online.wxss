.online-page{background:#15242a;min-height:100vh;color:#f7e8ca}.online-inner{padding:24rpx}.online-lobby,.waiting-card{background:#fff7e8;border-radius:18rpx;color:#283a39;padding:28rpx;margin-top:22rpx}.online-title{font-size:36rpx;font-weight:700}.online-desc{font-size:23rpx;color:#716858;line-height:1.6;margin:15rpx 0 28rpx}.online-lobby button{margin:16rpx 0;background:#e3ba75;color:#273637}.join-row{display:flex;align-items:center;gap:12rpx;margin-top:24rpx}.join-row input{background:#fff;border:1rpx solid #d7c8ab;border-radius:10rpx;padding:17rpx;min-width:0;flex:1}.join-row button{margin:0;white-space:nowrap}.room-strip,.seat-strip{display:flex;align-items:center;gap:12rpx;font-size:23rpx;margin-bottom:15rpx}.room-strip text{font-size:31rpx;color:#f5c97f;letter-spacing:4rpx}.room-strip button{margin:0;background:#e4bd7e;color:#283738}.seat-strip{color:#e6d0a8}.waiting-card{text-align:center;line-height:2}.waiting-card button{margin-top:20rpx}.versus{display:flex;align-items:center;justify-content:space-between;padding:18rpx;margin:15rpx 0}.vs{font-family:serif;color:#f1ce8b;font-size:30rpx}.reserve-row{display:flex;justify-content:space-between;color:#e7d3ad;font-size:22rpx;padding:0 12rpx 14rpx}.board-area{max-width:700rpx;margin:auto}.turn-status{margin-top:18rpx;border-radius:12rpx;background:#fff4df;color:#344340;padding:18rpx;font-size:25rpx}.room-actions{display:flex;gap:14rpx;margin-top:20rpx}.room-actions button{flex:1;margin:0;background:#e3ba75;color:#273637;font-size:22rpx}.online-error{margin-top:15rpx;padding:15rpx;background:#ffe8df;color:#9b3829;border-radius:12rpx;font-size:22rpx}.online-error button{display:inline-block;margin-left:12rpx}

.undo-request-card,.settings-area{background:#fff7e8;color:#283a39;border-radius:16rpx;padding:24rpx;margin-top:20rpx;font-size:25rpx;line-height:1.6}.undo-response-actions,.operation-actions{display:flex;gap:12rpx;margin-top:20rpx}.undo-response-actions button,.operation-actions button{flex:1;margin:0;background:#e3ba75;color:#273637;font-size:23rpx}.operation-actions button[disabled],.undo-response-actions button[disabled],.room-actions button[disabled]{background:#665b48;color:#d0c1a5}.operation-notice,.capture-notice{font-size:24rpx;line-height:1.5;color:#f5d49c;padding:16rpx 8rpx}.settings-area{padding:12rpx 24rpx}
