<view class="page online-page">
  <view class="topbar"><text class="topbar-back" bindtap="back">‹</text>远程双人<text class="topbar-tag">双设备联机</text></view>
  <view class="online-inner">
    <view wx:if="{{!snapshot.room}}" class="online-lobby">
      <view class="online-title">开启联机对局</view>
      <view class="online-desc">每台设备控制一方。建房后把房间码发给朋友，或者直接匹配。</view>
      <button id="online-create" loading="{{snapshot.busy}}" bindtap="createPrivate">创建私人房间</button>
      <button id="online-match" loading="{{snapshot.busy}}" bindtap="matchPublic">匹配对手</button>
      <view class="join-row"><input id="online-code" maxlength="8" placeholder="输入 8 位房间码" value="{{joinCode}}" bindinput="codeInput" /><button id="online-join" loading="{{snapshot.busy}}" bindtap="joinRoom">加入房间</button></view>
    </view>
    <view wx:else>
      <view class="room-strip">房间码 <text>{{snapshot.room.invite_code}}</text><button wx:if="{{snapshot.room.room_status == 'WAITING'}}" size="mini" bindtap="copyCode">复制</button><button wx:if="{{snapshot.room.room_status == 'WAITING'}}" size="mini" open-type="share">邀请</button></view>
      <view class="seat-strip">你执 {{snapshot.room.seat == 'A' ? '黑方 A' : '红方 B'}} · 第 {{snapshot.room.ply_count}} 手</view>
      <view wx:if="{{snapshot.room.room_status == 'WAITING'}}" class="waiting-card"><view>等待另一台设备加入…</view><view>房间 30 分钟内有效</view><button wx:if="{{snapshot.room.seat == 'A'}}" bindtap="cancelRoom">取消等待</button></view>
      <view wx:elif="{{snapshot.room.room_status == 'CANCELLED' || snapshot.room.room_status == 'EXPIRED'}}" class="waiting-card">房间已关闭，请返回首页重新建房</view>
      <view wx:else>
        <view class="versus ink-card"><player-card name="玩家 A" level="黑方" pieces="五马" avatar="棋" side="human" /><view class="vs">VS</view><player-card name="玩家 B" level="红方" pieces="五马" avatar="友" side="human" /></view>
        <view class="reserve-row"><text>A 备用棋 {{view.reserve.A}}</text><text>B 备用棋 {{view.reserve.B}}</text></view>
        <view class="board-area"><chess-board board="{{board}}" bind:node="onNode" /></view>
        <view wx:if="{{snapshot.room.pending_undo}}" class="undo-request-card">
          <view wx:if="{{snapshot.room.pending_undo.responder == snapshot.room.seat}}">
            <view>对方申请悔棋，将回退 {{snapshot.room.pending_undo.revert_count}} 手</view>
            <view class="undo-response-actions"><button id="online-undo-accept" disabled="{{operationBusy || !snapshot.canRespondToUndo}}" bindtap="acceptUndo">同意</button><button id="online-undo-decline" disabled="{{operationBusy || !snapshot.canRespondToUndo}}" bindtap="declineUndo">拒绝</button></view>
          </view>
          <view wx:else>等待对方处理悔棋申请… · 将回退 {{snapshot.room.pending_undo.revert_count}} 手</view>
        </view>
        <view wx:if="{{captureText}}" class="capture-notice">{{captureText}}</view>
        <view class="turn-status"><view wx:if="{{view.gameOver}}">{{view.winner == snapshot.room.seat ? '你获胜' : '对手获胜'}} · {{view.winnerMessage}}</view><view wx:elif="{{snapshot.room.pending_undo}}">悔棋协商中，棋盘已暂停</view><view wx:elif="{{snapshot.pendingOperation || snapshot.pendingMove}}">操作结果尚未确认，请重试原请求</view><view wx:elif="{{view.currentPlayer == snapshot.room.seat}}">你的回合 · 点选棋子和目标位置</view><view wx:else>等待对手落子…</view></view>
      </view>
      <view wx:if="{{snapshot.operationNotice}}" class="operation-notice">{{snapshot.operationNotice}}</view>
      <button wx:if="{{snapshot.room.room_status == 'FINISHED'}}" id="online-review" bindtap="viewReview">查看复盘</button>
      <view class="operation-actions"><button id="online-request-undo" disabled="{{operationBusy || !snapshot.canRequestUndo}}" bindtap="requestUndo">申请悔棋</button><button id="online-resign" disabled="{{operationBusy || !snapshot.canResign}}" bindtap="resign">认输</button><button id="online-settings" bindtap="settings">设置</button></view>
      <view wx:if="{{showSettings}}" class="settings-area"><game-settings settings="{{settings}}" bind:change="onSettingsChange" /></view>
      <view class="room-actions"><button disabled="{{operationBusy}}" bindtap="refreshRoom">刷新棋局</button><button disabled="{{operationBusy || snapshot.pendingOperation || snapshot.pendingMove}}" bindtap="leaveRoom">返回房间大厅</button></view>
    </view>
    <view wx:if="{{snapshot.error}}" class="online-error">{{snapshot.error}}<button size="mini" disabled="{{operationBusy}}" bindtap="retryOperation">{{snapshot.pendingOperation || snapshot.pendingMove ? '重试原请求' : '刷新重试'}}</button></view>
    <view wx:if="{{message}}" class="online-error">{{message}}</view>
  </view>
  <confirm-dialog visible="{{showUndoConfirm}}" title="申请悔棋？" message="{{undoMessage}}" bind:cancel="cancelUndo" bind:confirm="confirmUndo" />
  <confirm-dialog visible="{{showResign}}" title="确认认输？" message="你将认输，对方获得胜利。" bind:cancel="cancelResign" bind:confirm="confirmResign" />
</view>
