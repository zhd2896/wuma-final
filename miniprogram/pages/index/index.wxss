.home{background:#eee7d9}.hero{height:405rpx;background:#ede5d5;position:relative;text-align:center;padding-top:calc(28rpx + env(safe-area-inset-top));overflow:hidden}.hero-art{position:absolute;inset:0;width:100%;height:100%;opacity:.84}.hero::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(244,239,225,.08),rgba(244,239,225,.15) 62%,#ede5d5 100%);pointer-events:none}.hero-top{position:absolute;z-index:1;left:32rpx;right:32rpx;top:calc(18rpx + env(safe-area-inset-top));display:flex;justify-content:space-between;color:#263733;font-size:20rpx;letter-spacing:3rpx}.hero-right{color:#776d5d}.hero-title{position:relative;z-index:1;font-family:serif;font-size:112rpx;font-weight:900;letter-spacing:14rpx;color:#211f1a;text-shadow:2rpx 3rpx 0 rgba(255,247,230,.65);margin-top:62rpx;line-height:1.25}.hero-subtitle,.hero-line,.hero-note{position:relative;z-index:1}.hero-subtitle{font-size:24rpx;color:#303a34;letter-spacing:5rpx}.hero-line{width:110rpx;height:3rpx;background:#a7362d;margin:20rpx auto}.hero-note{font-family:serif;color:#5d5144;font-size:22rpx;letter-spacing:4rpx}.home-content{position:relative;margin:-22rpx 28rpx 0;padding:8rpx 16rpx 20rpx;background:rgba(255,249,236,.91);border-radius:24rpx 24rpx 0 0;box-shadow:0 -8rpx 25rpx rgba(42,38,27,.09)}.history-link{background:#f7eddd;border:1rpx solid #e4d0b3;border-radius:18rpx;display:flex;align-items:center;justify-content:space-between;padding:18rpx 25rpx;margin-top:22rpx}.history-title{font-weight:700;font-size:25rpx}.history-sub{font-size:20rpx;color:#857b69}.history-link>text{color:#a64a35;font-size:23rpx}.home-footer{text-align:center;color:#a49782;font-size:19rpx;letter-spacing:2rpx;margin:24rpx 0 0}
.rules-link{display:flex;align-items:center;gap:16rpx;margin-top:20rpx;padding:22rpx 18rpx;background:#f8eedc;border:1rpx solid #d8bd88;border-radius:18rpx}.rules-seal{flex-shrink:0;width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;background:#a9342a;border-radius:12rpx;color:#fff9ed;font-family:serif;font-size:32rpx}.rules-copy{flex:1;min-width:0}.rules-title{font-size:27rpx;font-weight:700;color:#17242b}.rules-sub{margin-top:6rpx;font-size:20rpx;color:#7d7161}.rules-arrow{flex-shrink:0;font-size:21rpx;color:#a9342a}
.guest-welcome{padding:24rpx 8rpx 8rpx}.guest-title{font-size:32rpx;font-weight:700;color:#263733}.guest-note{font-size:24rpx;line-height:1.7;color:#776d5d;margin:14rpx 0 24rpx}.guest-login{background:transparent;color:#876133;font-size:24rpx;margin-top:14rpx}.guest-login::after{border:0}
.continue-card { padding: 24rpx; margin: 18rpx 0; }
.continue-detail { font-size: 24rpx; line-height: 1.6; color: #776d5d; margin: 12rpx 0; }
