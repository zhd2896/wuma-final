<view class="page game-page">
  <view class="topbar"><text class="topbar-back" bindtap="back">‹</text>{{mode == 'local' ? '本地双人模式' : mode == 'remote' ? '远程双人模式' : 'AI 对弈'}}<text class="topbar-tag">{{mode == 'local' ? '本地双人' : mode == 'remote' ? '远程对局' : aiLevelLabel ? aiLevelLabel + ' AI' : 'AI'}}</text></view>
  <view class="game-inner">
    <view class="versus ink-card"><player-card name="{{mode == 'ai' ? aiAName : '黑方'}}" level="{{mode == 'ai' ? aiLevelLabel ? aiLevelLabel + '对弈' : 'AI 对弈' : mode == 'remote' ? '云端对局' : '本地对弈'}}" pieces="黑方 · 五马" avatar="{{mode == 'ai' && aiState.aiPlayer == 'A' ? '✦' : '棋'}}" side="{{mode == 'ai' && aiState.aiPlayer == 'A' ? 'ai' : 'human'}}" /><view class="vs">VS</view><player-card name="{{mode == 'ai' ? aiBName : '红方'}}" level="{{mode == 'ai' ? aiLevelLabel ? aiLevelLabel + '对弈' : 'AI 对弈' : mode == 'remote' ? '云端对局' : '本地对弈'}}" pieces="红方 · 五马" avatar="{{mode == 'ai' && aiState.aiPlayer == 'B' ? '✦' : '友'}}" side="{{mode == 'ai' && aiState.aiPlayer == 'B' ? 'ai' : 'human'}}" /></view>
    <view wx:if="{{mode == 'local' && localSession}}" class="reserve-row"><text>黑方 · 备用棋 {{localSession.gameState.players.A.reserve_count}}</text><text>红方 · 备用棋 {{localSession.gameState.players.B.reserve_count}}</text></view>
    <view wx:if="{{mode == 'remote' && remoteReady}}" class="reserve-row"><text>黑方 · 备用棋 {{remoteView.reserve.A}}</text><text>红方 · 备用棋 {{remoteView.reserve.B}}</text></view>
    <view wx:if="{{mode == 'ai' && aiReady}}" class="reserve-row"><text>{{aiAName}} · 备用棋 {{aiView.reserve.A}}</text><text>{{aiBName}} · 备用棋 {{aiView.reserve.B}}</text></view>
    <view class="turn-status turn-priority" aria-role="status"><view class="status-dot"></view><view>
      <block wx:if="{{mode == 'local'}}">
        <view class="status-title">{{localView ? localView.turnTitle : '本地棋局暂不可用'}}</view>
        <view class="status-sub">{{localView ? localView.gameOver ? localView.winnerMessage : localView.guidanceText : localErrorMessage}}</view>
      </block>
      <block wx:elif="{{mode == 'remote'}}">
        <view class="status-title">{{remoteView ? remoteView.turnTitle : '正在准备远程棋局'}}</view>
        <view wx:if="{{remoteView && remoteView.gameOver}}" class="status-sub">{{remoteView.winnerMessage}}</view>
        <view wx:elif="{{remoteState.isSubmittingMove || operationBusy}}" class="status-sub">正在提交操作，请稍候…</view>
        <view wx:elif="{{remoteState.isLoadingLegalMoves}}" class="status-sub">正在获取可走位置…</view>
        <view wx:elif="{{remoteState.needsResync}}" class="status-sub">棋局需要同步，请先重试</view>
        <view wx:else class="status-sub">{{remoteView ? remoteView.guidanceText : '等待棋局加载'}}</view>
      </block>
      <block wx:else>
        <view class="status-title">{{aiReady ? aiView.gameOver ? aiState.gameState.winner == aiState.humanPlayer ? '你获胜' : 'AI 获胜' : aiState.gameState.current_player == aiState.humanPlayer ? '你的回合' : 'AI 的回合' : '正在准备 AI 棋局'}}</view>
        <view wx:if="{{aiReady && aiView.gameOver}}" class="status-sub">{{aiView.winnerMessage}}</view>
        <view wx:elif="{{aiState.isAiThinking}}" class="status-sub"><ai-thinking /></view>
        <view wx:elif="{{aiState.isSubmittingMove || operationBusy}}" class="status-sub">正在提交操作，请稍候…</view>
        <view wx:elif="{{aiState.isLoadingLegalMoves}}" class="status-sub">正在获取可走位置…</view>
        <view wx:elif="{{aiState.needsResync}}" class="status-sub">棋局需要同步，请先重试</view>
        <view wx:else class="status-sub">{{aiGuidanceText}}</view>
      </block>
    </view></view>
    <view wx:if="{{mode == 'local' && localView.captureText}}" class="capture-notice">{{localView.captureText}}</view>
    <view wx:if="{{mode == 'remote' && remoteCaptureText}}" class="capture-notice">{{remoteCaptureText}}</view>
    <view wx:if="{{mode == 'ai' && aiCaptureText}}" class="capture-notice">{{aiCaptureText}}</view>
    <view wx:if="{{mode == 'local' && localSession || mode == 'remote' && remoteReady || mode == 'ai' && aiReady}}" id="game-board-preview" class="board-area">
      <view wx:if="{{analysisPreviewId}}" class="preview-notice">
        <view class="preview-heading"><text>{{analysisPreviewText}}</text><button size="mini" bindtap="clearAnalysisPreview">清除预览</button></view>
        <view class="preview-purpose">{{analysisPreviewPurpose}}</view>
        <view class="preview-note">路线仅供查看；落子请点选棋盘。</view>
      </view>
      <chess-board high-contrast="{{settings.highContrastBoard}}" large-text="{{settings.largeBoardText}}" board="{{board}}" show-node-labels="{{settings.showNodeLabels}}" show-guidance="{{true}}" bind:node="onNode" />
    </view>
    <view wx:if="{{mode == 'local' && localErrorMessage}}" class="remote-info remote-error"><text>{{localErrorMessage}}</text><button size="mini" bindtap="restartLocalGame">重试新局</button></view>
    <view wx:if="{{mode == 'remote' && remoteState.isLoadingGame}}" class="remote-info">正在读取云端棋局…</view>
    <view wx:if="{{mode == 'remote' && remoteState.errorMessage}}" class="remote-info remote-error"><text>{{remoteState.errorMessage}}</text><button size="mini" bindtap="retryRemoteGame">重试</button></view>
    <view wx:if="{{mode == 'remote' && remoteState.notice}}" class="remote-info">{{remoteState.notice}}</view>
    <view wx:if="{{mode == 'ai' && aiState.isLoadingGame}}" class="remote-info">正在读取 AI 棋局…</view>
    <view wx:if="{{mode == 'ai' && aiState.errorMessage}}" class="remote-info remote-error"><text>{{aiState.errorMessage}}</text><button size="mini" bindtap="retryAiGame">重试</button></view>
    <view wx:if="{{mode == 'ai' && aiState.notice}}" class="remote-info">{{aiState.notice}}</view>
    <view wx:if="{{mode == 'ai' && aiState.isCoachLoading}}" class="analysis-status">正在准备提示...</view>
    <view wx:if="{{mode == 'ai' && aiState.coachErrorMessage}}" class="analysis-status analysis-error">{{aiState.coachErrorMessage}}</view>
    <view wx:if="{{mode == 'ai' && aiState.coachHint}}" class="analysis-card coach-card">
      <view class="analysis-title">{{aiState.coachHint.level == 1 ? '一级提示 · 关注什么' : aiState.coachHint.level == 2 ? '二级提示 · 重点棋子' : '三级提示 · 推荐走法'}}</view>
      <view class="analysis-line">{{aiState.coachHint.hintText}}</view>
      <view wx:if="{{aiState.coachHint.level == 1}}" class="analysis-line">关注点：<text wx:for="{{aiState.coachHint.focusTopics}}" wx:key="*this">{{item}} </text></view>
      <view wx:if="{{aiState.coachHint.level == 2}}" class="analysis-line">候选棋子：<text wx:for="{{aiState.coachHint.candidateFromNodes}}" wx:key="*this">{{item}} </text></view>
      <view wx:if="{{aiState.coachHint.level == 3 && aiState.coachHint.bestMove}}" class="analysis-line">推荐走法：{{aiState.coachHint.bestMove.from}} → {{aiState.coachHint.bestMove.to}}</view>
      <button wx:if="{{aiState.coachHint.level < 3 && !aiState.isCoachLoading}}" id="coach-more" class="coach-more" bindtap="hint">{{aiState.coachHint.level == 1 ? '查看更多提示' : '查看推荐走法'}}</button>
    </view>
    <view wx:if="{{mode == 'ai' && aiState.isAnalyzing}}" class="analysis-status">正在分析局面...</view>
    <view wx:if="{{mode == 'ai' && aiState.analysisErrorMessage}}" class="analysis-status analysis-error">{{aiState.analysisErrorMessage}}</view>
    <view wx:if="{{mode == 'ai' && aiAnalysisView}}" class="analysis-summary">
      <evaluation-panel analysis="{{aiAnalysisView}}" reset-key="{{aiState.gameId + ':' + aiState.gameVersion}}" bind:select="selectAnalysisMove" />
    </view>
    <button wx:if="{{mode == 'ai' && aiReady && aiView.gameOver || mode == 'remote' && remoteReady && remoteView.gameOver}}" class="review-button" data-action="review" bindtap="onAction">查看复盘</button>
    <view wx:if="{{showSettings}}" class="settings-area"><view class="settings-title">{{mode == 'local' ? '本地对局设置' : mode == 'remote' ? '远程对局设置' : 'AI 对弈设置'}}</view><game-settings settings="{{settings}}" showAiFirstPlayer="{{mode == 'ai'}}" bind:change="onSettingsChange" /></view>
    <view class="operation-heading">辅助操作<text>落子请直接点选棋盘</text></view>
    <view class="actions">
      <view id="action-undo" class="{{operationBusy || mode == 'local' && (!localSession || localSession.gameState.game_status != 'PLAYING' || !localSession.undoFrame) || mode == 'ai' && (!aiReady || aiState.gameState.game_status != 'PLAYING' || aiUndoPlies == 0) || mode == 'remote' && (!remoteReady || remoteState.gameState.game_status != 'PLAYING' || remoteState.plyCount == 0) ? 'action-disabled' : ''}}" data-action="undo" bindtap="onAction"><text>↶</text><view>悔棋</view></view>
      <view id="action-resign" class="{{operationBusy || mode == 'local' && (!localSession || localSession.gameState.game_status != 'PLAYING') || mode == 'ai' && (!aiReady || aiState.gameState.game_status != 'PLAYING') || mode == 'remote' && (!remoteReady || remoteState.gameState.game_status != 'PLAYING') ? 'action-disabled' : ''}}" data-action="resign" bindtap="onAction"><text>旗</text><view>认输</view></view>
      <view wx:if="{{mode == 'ai'}}" id="action-hint" class="{{mode == 'ai' && (!aiReady || aiState.gameState.game_status != 'PLAYING' || aiState.gameState.current_player != aiState.humanPlayer || aiState.isAiThinking || aiState.isSubmittingMove || aiState.isCoachLoading || aiState.needsResync) ? 'action-disabled' : ''}}" data-action="hint" bindtap="onAction"><text>✦</text><view>走棋提示</view></view>
      <view id="action-analysis" data-action="analysis" bindtap="onAction"><text>▥</text><view>{{mode == 'ai' ? '局面分析' : '分析'}}</view></view>
      <view id="action-restart" data-action="restart" bindtap="onAction"><text>↻</text><view>{{(mode == 'local' && localSession.gameState.game_status == 'FINISHED') || (mode == 'ai' && aiState.gameState.game_status == 'FINISHED') || (mode == 'remote' && remoteState.gameState.game_status == 'FINISHED') ? '再来一局' : '新开一局'}}</view></view>
      <view id="action-settings" data-action="settings" bindtap="onAction"><text>⚙</text><view>设置</view></view>
    </view>
  </view>
  <confirm-dialog visible="{{showUndoConfirm}}" title="确认悔棋？" message="{{undoMessage}}" bind:cancel="cancelUndo" bind:confirm="confirmUndo" />
  <confirm-dialog visible="{{showResign}}" title="确认结束对局？" message="{{resignMessage}}" bind:cancel="cancelResign" bind:confirm="confirmResign" />
  <confirm-dialog visible="{{showRestart}}" title="新开一局？" message="{{restartMessage}}" bind:cancel="cancelRestart" bind:confirm="confirmRestart" /><bottom-nav current="game" />
</view>
