.profile-page{background:#f4eee2}.profile-hero{margin-top:25rpx;padding:28rpx;background:linear-gradient(130deg,#101e23,#253637);position:relative;overflow:hidden}.profile-art{position:absolute;inset:0;width:100%;height:100%;opacity:.12}.profile-top,.profile-motto{position:relative}.profile-top{display:flex;align-items:center;gap:18rpx}.profile-avatar{width:85rpx;height:85rpx;border-radius:50%;background:linear-gradient(135deg,#f7d69e,#aa7140);display:flex;align-items:center;justify-content:center;font-size:41rpx;color:#49311b;font-family:serif;border:3rpx solid #f2cf91}.profile-name{flex:1;font-size:30rpx;font-weight:700}.profile-name text{font-size:21rpx;color:#f0c684}.level-seal{width:60rpx;height:60rpx;border:3rpx solid #d9af68;color:#e6c47e;display:flex;align-items:center;justify-content:center;font-family:serif;font-size:29rpx;transform:rotate(8deg)}.profile-motto{font-size:20rpx;color:#bdc8c2;margin-top:22rpx;letter-spacing:3rpx}.stat-card{display:flex;margin-top:18rpx;padding:23rpx 4rpx}.stat-card>view{flex:1;text-align:center;border-right:1rpx solid #e9dac4}.stat-card>view:last-child{border-right:0}.stat-card text{font-size:20rpx;color:#7b7c74}.stat-card>view>view{font-size:31rpx;font-weight:700;margin-top:8rpx}.analysis-card{padding:22rpx}.demo-switch{display:flex;align-items:center;justify-content:space-between;font-size:22rpx;color:#5f675f}.switch{width:76rpx;height:42rpx;border-radius:26rpx;background:#c9c7c0;padding:4rpx;transition:background .2s}.switch.on{background:#b24034}.switch view{height:34rpx;width:34rpx;border-radius:50%;background:white;transition:transform .2s}.switch.on view{transform:translateX(34rpx)}.demo-warning{font-size:20rpx;color:#277998;background:#e8f2f3;border-radius:10rpx;padding:10rpx 15rpx;margin:20rpx 0}.ability-row{display:flex;align-items:center;gap:15rpx;margin:15rpx 0;font-size:21rpx}.ability-row text:first-child{width:62rpx}.ability-row text:last-child{width:35rpx;text-align:right;color:#a54a38}.ability-track{height:15rpx;flex:1;background:#e8dcc9;border-radius:10rpx;overflow:hidden}.ability-track view{height:100%;background:linear-gradient(90deg,#bd8d4d,#b33d32);border-radius:10rpx}.link-card{display:flex;justify-content:space-between;align-items:center;padding:21rpx 25rpx;margin-bottom:13rpx;font-size:25rpx;font-weight:700}.link-card text{display:block;font-size:20rpx;font-weight:400;color:#899088;margin-top:4rpx}.link-card>view:last-child{color:#bd8b4b;font-size:42rpx}
.profile-metric{font-size:23rpx;color:#53615b;margin:15rpx 0}
