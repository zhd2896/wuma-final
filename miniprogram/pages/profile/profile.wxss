.profile-page{background:#f4eee2}.profile-hero{margin-top:25rpx;padding:28rpx;background:linear-gradient(130deg,#101e23,#253637);position:relative;overflow:hidden}.profile-art{position:absolute;inset:0;width:100%;height:100%;opacity:.12}.profile-top,.profile-motto{position:relative}.profile-top{display:flex;align-items:center;gap:18rpx}.profile-avatar{width:85rpx;height:85rpx;border-radius:50%;background:linear-gradient(135deg,#f7d69e,#aa7140);display:flex;align-items:center;justify-content:center;font-size:41rpx;color:#49311b;font-family:serif;border:3rpx solid #f2cf91}.profile-name{flex:1;font-size:30rpx;font-weight:700}.profile-name text{font-size:21rpx;color:#f0c684}.level-seal{width:60rpx;height:60rpx;border:3rpx solid #d9af68;color:#e6c47e;display:flex;align-items:center;justify-content:center;font-family:serif;font-size:29rpx;transform:rotate(8deg)}.profile-motto{font-size:20rpx;color:#bdc8c2;margin-top:22rpx;letter-spacing:3rpx}.stat-card{display:flex;margin-top:18rpx;padding:23rpx 4rpx}.stat-card>view{flex:1;text-align:center;border-right:1rpx solid #e9dac4}.stat-card>view:last-child{border-right:0}.stat-card text{font-size:20rpx;color:#7b7c74}.stat-card>view>view{font-size:31rpx;font-weight:700;margin-top:8rpx}.analysis-card{padding:22rpx}.ability-track{height:15rpx;flex:1;background:#e8dcc9;border-radius:10rpx;overflow:hidden}.ability-track view{height:100%;background:linear-gradient(90deg,#bd8d4d,#b33d32);border-radius:10rpx}.link-card{display:flex;justify-content:space-between;align-items:center;padding:21rpx 25rpx;margin-bottom:13rpx;font-size:25rpx;font-weight:700}.link-card text{display:block;font-size:20rpx;font-weight:400;color:#899088;margin-top:4rpx}.link-card>view:last-child{color:#bd8b4b;font-size:42rpx}
.profile-metric{font-size:23rpx;color:#53615b;margin:15rpx 0}
.skill-overall{position:relative;color:#f0c684;font-size:23rpx;margin-top:22rpx}
.skill-metric{padding:18rpx 0;border-bottom:1rpx solid #e9dac4}.skill-metric:first-child{padding-top:0}
.ability-row{display:flex;justify-content:space-between;align-items:center;gap:15rpx;font-size:25rpx;margin-bottom:13rpx}
.ability-value{color:#a54a38;font-size:23rpx}.skill-samples{font-size:22rpx;color:#53615b;margin-top:12rpx}
.skill-description{font-size:20rpx;color:#7b7c74;margin-top:7rpx;line-height:1.5}
.skill-disclaimer{font-size:20rpx;color:#7b7c74;line-height:1.6;margin-top:20rpx}

.logout-button{margin:30rpx 0;background:transparent;color:#8f5145;font-size:25rpx;border:1rpx solid #d9c7b5;border-radius:14rpx}.logout-button::after{border:0}
.profile-editor { padding: 24rpx; margin-bottom: 24rpx; }
.profile-editor input { border-bottom: 1rpx solid #9e8b70; padding: 16rpx; margin-bottom: 20rpx; }
.avatar-options { display: flex; gap: 16rpx; margin: 16rpx 0; }
.avatar-options button { border-radius: 50%; width: 80rpx; height: 80rpx; line-height: 80rpx; padding: 0; }
.avatar-selected { color: #9c3028; border: 3rpx solid #9c3028; }
.profile-save-error { color: #9c3028; margin: 12rpx 0; }
.chart-mode-tabs{display:flex;gap:12rpx;margin-bottom:20rpx}.chart-mode-button{flex:1;min-width:0;padding:0 8rpx;margin:0;font-size:25rpx;line-height:72rpx;color:#715e44;background:#f4ead8;border:1rpx solid #decaab;border-radius:12rpx}.chart-mode-button::after{border:0}.chart-mode-active{background:#a9342a;color:#fff9ed;border-color:#a9342a}.chart-evidence-title{font-size:25rpx;font-weight:700;color:#53615b;margin-top:26rpx;padding-top:20rpx;border-top:1rpx solid #e9dac4}

.growth-tasks{display:flex;flex-direction:column;gap:16rpx}.growth-task{padding:24rpx}.growth-priority{border-left:6rpx solid #487751}.growth-title{font-size:28rpx;font-weight:600;color:#354332;line-height:1.5}.growth-progress{margin-top:8rpx;color:#58744c;font-size:23rpx}.growth-reason,.growth-rate{margin-top:10rpx;color:#706757;font-size:23rpx;line-height:1.6}.growth-task button{margin-top:18rpx;background:#d9b778;color:#293b2e;font-size:25rpx}.growth-note{font-size:21rpx;color:#877b66;line-height:1.6;margin-top:14rpx}.growth-trend{padding:24rpx}.growth-empty{padding:20rpx;font-size:24rpx;color:#81735c;line-height:1.6}.growth-bars{display:flex;gap:5rpx;margin-top:24rpx}.growth-day{flex:1;min-width:0;text-align:center;font-size:17rpx;color:#716750}.growth-count{height:25rpx}.growth-bar-track{height:110rpx;position:relative;border-bottom:1rpx solid #b7aa91}.growth-bar{position:absolute;bottom:0;width:100%;background:#b7ccae;border-radius:5rpx 5rpx 0 0}.growth-bar-recent{background:#528152}.growth-day text{display:block;height:28rpx;font-size:17rpx;white-space:nowrap;margin-top:6rpx}
.growth-attempt { background: #ded2bb; width: 100%; }
.growth-bar:not(.growth-attempt) { width: 65%; left: 17.5%; }
