<view class="page profile-page"><view class="topbar"><text class="topbar-back" bindtap="back">‹</text>我的棋力<text class="topbar-tag">个人中心</text></view>
  <view class="page-inner"><view class="profile-hero ink-card"><image class="profile-art" src="../../assets/ink-landscape.jpg" mode="aspectFill" /><view class="profile-top"><view class="profile-avatar">棋</view><view class="profile-name"><view>{{profile.name}}</view><text>{{profile.level}}</text></view><view class="level-seal">初</view></view><view class="profile-motto">以棋会友 · 于对弈中精进</view></view>
  <view class="stat-card card"><view><text>对局总数</text><view>{{profile.games}}</view></view><view><text>训练完成</text><view>{{profile.training}}</view></view><view><text>棋力等级</text><view>待评估</view></view></view>
  <section-title title="能力分析" subtitle="完成对局后生成" /><view class="analysis-card card"><view class="demo-switch" bindtap="toggleDemo"><text>UI 演示开关</text><view class="switch {{showDemo ? 'on' : ''}}"><view></view></view></view><view wx:if="{{showDemo}}"><view class="demo-warning">演示数据 · 非真实玩家能力分析</view><view wx:for="{{ratings}}" wx:key="label" class="ability-row"><text>{{item.label}}</text><view class="ability-track"><view style="width:{{item.value}}%"></view></view><text>{{item.value}}</text></view></view><empty-state wx:else title="完成更多对局后生成棋力分析" subtitle="当前尚无真实 PlayerRating 数据" /></view>
  <section-title title="棋路记录" /><view class="link-card card" bindtap="openHistory"><view>历史对局<text>查看对局与演示复盘</text></view><view>›</view></view><view class="link-card card" bindtap="openGame"><view>开始对弈<text>从一场新棋局开始</text></view><view>›</view></view></view>
  <bottom-nav current="profile" />
</view>
