page { background: var(--paper); color: var(--ink); font-family: "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; }
view, text, image, button { box-sizing: border-box; }
.page { min-height: 100vh; padding-bottom: calc(132rpx + env(safe-area-inset-bottom)); overflow-x: hidden; }
.page-inner { padding: 0 30rpx 32rpx; }
.topbar { height: 116rpx; padding-top: env(safe-area-inset-top); background: var(--ink); color: #fff9ee; display: flex; align-items: center; justify-content: center; position: relative; font-weight: 600; letter-spacing: 3rpx; }
.topbar-back { position: absolute; left: 30rpx; bottom: 26rpx; font-size: 42rpx; line-height: 1; font-weight: 300; }
.topbar-tag { position: absolute; right: 30rpx; bottom: 29rpx; color: var(--gold-light); font-size: 20rpx; letter-spacing: 1rpx; font-weight: 400; }
.card { background: rgba(255, 250, 240, .95); border: 1rpx solid rgba(175, 145, 101, .24); border-radius: var(--radius); box-shadow: var(--shadow); }
.ink-card { background: linear-gradient(145deg, #22343a, #101e27); border: 1rpx solid #58615c; border-radius: var(--radius); color: #fff7e8; box-shadow: var(--shadow); }
.label { color: var(--muted); font-size: 23rpx; }
.demo-tag { display: inline-block; background: #e8f2f4; color: #276583; border-radius: 20rpx; padding: 5rpx 14rpx; font-size: 20rpx; letter-spacing: 1rpx; }
.primary-btn { background: linear-gradient(135deg, #ba4537, #8d2926); color: #fff8eb; border-radius: 18rpx; font-size: 27rpx; font-weight: 600; box-shadow: 0 8rpx 16rpx rgba(123, 32, 25, .18); }
.gold-btn { background: linear-gradient(135deg, #f4d99e, #ca944a); color: #392b1b; border-radius: 18rpx; font-size: 25rpx; font-weight: 600; }
.ghost-btn { background: #fff7e8; color: var(--ink); border: 1rpx solid var(--line); border-radius: 18rpx; font-size: 25rpx; }
.primary-btn::after, .gold-btn::after, .ghost-btn::after { border: 0; }
.section-row { display: flex; align-items: center; justify-content: space-between; margin: 30rpx 0 18rpx; }
.section-heading { font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx; }
.section-more { color: var(--gold); font-size: 23rpx; }
.tabs { display: flex; background: var(--ink); padding: 8rpx; border-radius: 17rpx; margin: 22rpx 0; }
.tab { flex: 1; text-align: center; color: #b6c0c0; padding: 14rpx 0; font-size: 24rpx; border-radius: 12rpx; }
.tab.active { color: #3b2b1e; background: linear-gradient(135deg, #fff0ce, #d5a75e); font-weight: 700; }
.muted { color: var(--muted); }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
