# Copy to .env for Compose. Replace both passwords before any shared deployment.
# Never commit .env. DATABASE_URL may be left empty to use DB_* below.
COMPOSE_PROJECT_NAME=wuma
BACKEND_IMAGE=wuma-backend:phase27
WUMA_ENV=production
DATABASE_URL=
DB_NAME=wuma
DB_USER=wuma
DB_PASSWORD=replace-with-unique-app-password
DB_ROOT_PASSWORD=replace-with-unique-root-password

# The default HTTP listener is local-only. Use 0.0.0.0, HTTP_PORT=80,
# HTTPS_PORT=443, a TLS config and a real certificate directory for production.
NGINX_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
NGINX_CONFIG=./deploy/nginx/conf.d/local.conf
TLS_CERT_DIR=./deploy/nginx/empty-certs

# Optional. Leave empty for deterministic Review and Coach fallback.
LLM_PROVIDER=configured
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8
LLM_TOTAL_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.1

# WeChat mini-program login. AppID must match project.config.json and the published app.
# Store AppSecret only on the backend; never include it in the mini-program bundle.
WECHAT_APP_ID=wx698f21721461ccf5
WECHAT_APP_SECRET=
AUTH_SESSION_DAYS=7
