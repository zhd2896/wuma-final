import { readFileSync,writeFileSync,existsSync } from 'node:fs';
import { registerHooks } from 'node:module';
registerHooks({resolve(s,c,n){try{return n(s,c)}catch(e){if(s.startsWith('.')&&c.parentURL&&existsSync(new URL(s+'.ts',c.parentURL)))return n(new URL(s+'.ts',c.parentURL).href,c);throw e}}});
const { growth }=await import('../tests/fixtures/growth.mts');
const { growthPresentation }=await import('../miniprogram/pages/profile/growth-presentation.ts');
const { parseGrowth }=await import('../miniprogram/services/growth-contract.ts');
const evidence=growth();
const empty={...evidence,themes:evidence.themes.map(t=>({...t,attempts:0,correct:0,accuracy:null,completedThisWeek:0,remaining:2,recommendedDifficulty:'EASY'})),recent:{current:{...evidence.recent.current,completed:0,attempted:0,firstAttempts:0,firstCorrect:0,accuracy:null},previous:{...evidence.recent.previous,completed:0,attempted:0,firstAttempts:0,firstCorrect:0,accuracy:null}},daily:evidence.daily.map(d=>({...d,completed:0,attempted:0}))};
const styles=readFileSync('miniprogram/pages/profile/profile.wxss','utf8').replace(/([\d.]+)rpx/g,(_,n)=>Number(n)/2+'px');
const esc=(s:string)=>s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
const panels=[evidence,empty].map((g,i)=>{
 const p=growthPresentation(parseGrowth(g));const trend=p.growthTrend!;
 return `<section><h2>${i?'新用户 · 样本不足':'防守优先 · 近期训练变化'}</h2><h3>下一步任务</h3><p class="subtitle">最近7天每个主题完成两道不同题</p>${p.growthTasks.map(t=>`<div class="card growth-task ${t.priority?'growth-priority':''}"><div class="growth-title">${esc(t.title)}</div><div class="growth-progress">${esc(t.progressText)}</div><div class="growth-reason">${esc(t.reason)}</div><button>${esc(t.actionText)}</button></div>`).join('')}<h3>近期训练趋势</h3><div class="card growth-trend"><div class="growth-title">${esc(trend.completionText)}</div><div class="growth-rate">${esc(trend.accuracyText)}</div>${trend.hasActivity?`<div class="growth-bars">${trend.days.map(d=>`<div class="growth-day"><div class="growth-count">${d.completed}</div><div class="growth-bar-track"><div class="growth-bar ${d.recent?'growth-bar-recent':''}" style="height:${d.height}%"></div></div><span>${d.label}</span></div>`).join('')}</div>`:'<div class="growth-empty">还没有近期训练记录，先从上面的基础任务开始。</div>'}<div class="growth-note">${esc(trend.disclaimer)}</div></div></section>`;
}).join('');
writeFileSync('results/growth-feedback-preview.html',`<!doctype html><html lang="zh-CN"><meta charset="utf-8"><title>成长反馈布局验证</title><style>*{box-sizing:border-box}body{margin:0;background:#eee7d6;font-family:'Microsoft YaHei',sans-serif;color:#423a2f}header{padding:20px}main{display:grid;grid-template-columns:repeat(2,360px);gap:20px;justify-content:center}section{padding:18px;background:#f8f0df;border-radius:12px}h2{font-size:17px;margin:0 0 20px}h3{font-size:17px;margin:18px 0 6px}.subtitle{font-size:12px;color:#86775e;margin-top:0}.card{background:#fffaf0;border:1px solid #e1d4b7;border-radius:10px;margin-bottom:10px}button{display:block;width:100%;border:0;border-radius:7px;padding:10px}.growth-day span{display:block;font-size:8px;margin-top:5px;white-space:nowrap}${styles}</style><header>成长反馈布局预览 · 生产展示模型与样式<br><small>演示数据；浏览器检查，不是微信真机截图</small></header><main>${panels}</main></html>`);
