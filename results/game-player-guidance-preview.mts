// Browser layout check using real RuleEngine states and production styles. Not a WeChat screenshot.
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { registerHooks } from 'node:module';
registerHooks({ resolve(s, c, next) { try { return next(s, c); } catch(e) { if (s.startsWith('.') && c.parentURL && existsSync(new URL(s + '.ts', c.parentURL))) return next(new URL(s + '.ts', c.parentURL).href, c); throw e; } } });
const { NODE_IDS, createInitialGameState, RuleEngine } = await import('../miniprogram/domain/index.ts');
const { mapGameStateToView } = await import('../miniprogram/pages/game/game-state-mapper.ts');
const initial = createInitialGameState();
const own = mapGameStateToView(initial, { selectedNode: 'P01', legalTargets: RuleEngine.getAllLegalMoves(initial).filter(m => m.from === 'P01').map(m => m.to), lastMove: null }, 'A');
const occupancy = { ...initial.board.occupancy };
for (const id of NODE_IDS) occupancy[id] = null;
Object.assign(occupancy, { P01: 'A', P02: 'B', P04: 'A', P29: 'B' });
const turn = RuleEngine.executeTurn({ ...initial, board: { occupancy } }, { from: 'P04', to: 'P03' });
const local = mapGameStateToView(turn.state, { selectedNode: null, legalTargets: [], lastMove: turn.move, lastCapture: turn.captures });
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const styles = ['miniprogram/pages/game/game.wxss', 'miniprogram/pages/online/online.wxss', 'miniprogram/components/chess-board/chess-board.wxss', 'miniprogram/components/chess-piece/chess-piece.wxss'].map(f => readFileSync(f, 'utf8')).join('\n').replace(/([\d.]+)rpx/g, (_, n) => Number(n) / 2 + 'px');
function board(view: typeof own) {
 const b = view.board;
 return `<div class="board-wrap"><div class="board-frame"><div class="temple-label apex">南天寿（宝顶）</div><div class="temple-label left-wing">和（左翼）</div><div class="temple-label right-wing">唐（右翼）</div>${b.lines.map(l => `<div class="line" style="left:${l.x}%;top:${l.y}%;width:${l.width}%;transform:rotate(${l.angle}deg)"></div>`).join('')}${b.nodes.map(n => `<div class="node-hit ${n.captured || n.replacement ? 'capture-spot' : ''}" style="left:${n.x}%;top:${n.y}%"><div class="node-dot ${n.legalTarget ? 'legal-target' : ''} ${n.captured ? 'capture-hit' : ''} ${n.replacement ? 'replacement-hit' : ''}"></div></div>`).join('')}${b.pieces.map(p => `<div class="piece-position" style="left:${p.x}%;top:${p.y}%"><div class="piece ${p.side} ${p.nodeId === b.selectedId ? 'selected' : p.state}"><div class="glint"></div></div></div>`).join('')}${b.nodes.filter(n => n.legalTarget || n.captured || n.replacement).map(n => `<div class="guidance-marker ${n.legalTarget ? 'legal-marker' : 'capture-marker'}" style="left:${n.x}%;top:${n.y}%">${n.legalTarget ? '可走' : n.replacement ? '换入' : '吃子'}</div>`).join('')}<div class="board-plaque">五 马 棋</div></div></div>`;
}
const panels = [own, local].map((v, i) => `<section class="game-inner"><h2>${i ? '本地 · 真实夹吃后' : '联机 · 黑方选子'}</h2><div class="players"><div>${escape(v.playerNames.A)}<small>黑方 · 备用棋 ${v.reserve.A}</small></div><span>VS</span><div>${escape(v.playerNames.B)}<small>红方 · 备用棋 ${v.reserve.B}</small></div></div><div class="turn-status turn-priority"><div><div class="status-title">${escape(v.turnTitle)}</div><div class="status-sub">${escape(v.guidanceText)}</div></div></div>${v.captureText ? `<div class="capture-notice">${escape(v.captureText)}</div>` : ''}${board(v)}<div class="operation-heading">辅助操作<small>落子请直接点选棋盘</small></div><div class="buttons"><button>悔棋</button><button>认输</button><button>设置</button></div></section>`).join('');
writeFileSync('results/game-player-guidance-preview.html', `<!doctype html><html lang="zh-CN"><meta charset="utf-8"><title>对局操作引导布局验收</title><style>*{box-sizing:border-box}body{margin:0;background:#eee6d9;font-family:'Microsoft YaHei',sans-serif;color:#30291f}header{padding:20px}main{display:grid;grid-template-columns:repeat(2,370px);gap:20px;justify-content:center}section{border-radius:12px;color:#eee1c6}h2{font-size:17px;margin:2px 0 15px}.players{display:flex;align-items:center;justify-content:space-between;background:#fff2da;color:#302b24;padding:15px;border-radius:10px;font-weight:bold}.players small{display:block;font-size:12px;font-weight:normal;margin-top:6px}.buttons{display:flex;gap:8px;margin-top:12px}.buttons button{flex:1;background:#e3ba75;border:0;border-radius:8px;padding:12px;color:#273637}.temple-label{font-size:12px!important}.capture-hit::after{animation:none!important}${styles}</style><header>对局引导布局预览 · 使用真实规则状态与生产样式<br><small>浏览器布局检查，未替代微信真机验收</small></header><main>${panels}</main></html>`, 'utf8');
